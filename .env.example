# Sanity project details, supplied after the lab creates its Sanity project.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-01
SANITY_READ_TOKEN=

# The canonical public URL and publishing gate.
SITE_URL=https://example.org
PUBLICATION_MODE=preview

# Local redesign review uses PPT-based sample content by default.
# Set CONTENT_SOURCE=sanity to inspect current CMS records locally.
CONTENT_SOURCE=ppt-preview
