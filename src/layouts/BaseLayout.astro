---
import '../styles/global.css';
import type { SiteContent } from '../lib/content';
import { sitePath } from '../lib/paths';

type Props = { title: string; description: string; active?: string; content: SiteContent };
const { title, description, active = '', content } = Astro.props;
const { settings } = content;
const isDraft = import.meta.env.PUBLICATION_MODE !== 'production' || !content.readyToPublish;
const canonical = new URL(Astro.url.pathname, import.meta.env.SITE_URL || 'https://example.org').href;
const nav = [
  { label: 'Home', href: '/', key: 'home' },
  { label: 'Research', href: '/research/', key: 'research' },
  { label: 'People', href: '/people/', key: 'people' },
  { label: 'Outcomes', href: '/outcomes/', key: 'outcomes' },
  { label: 'Activities', href: '/activities/', key: 'activities' },
  { label: 'Links', href: '/links/', key: 'links' },
  { label: 'Contact', href: '/contact/', key: 'contact' }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fffaf6" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | ${settings.labName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {isDraft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <title>{title} | {settings.labName}</title>
  </head>
  <body>
    {isDraft && <div class="preview-banner" role="status">Local design preview · content awaits final review</div>}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={sitePath('/')} aria-label="OICL home">
          <span class="brand-copy">
            <img class="brand-logo" src={sitePath('/images/brand/oicl-fiber-wordmark.svg')} alt="" width="405" height="122" />
            <span class="brand-title"><span class="brand-title-text"><strong>{settings.officialName || 'Optical Information and Communications Laboratory'}</strong>{settings.chineseName && <span lang="zh-CN">{settings.chineseName}</span>}</span></span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {nav.map((item) => <a href={sitePath(item.href)} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <details class="mobile-menu">
          <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
          <nav aria-label="Mobile navigation">
            {nav.map((item) => <a href={sitePath(item.href)} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div class="footer-identity">
          <a class="footer-brand" href={sitePath('/')} aria-label="OICL home">
            <span class="brand-copy">
              <img class="brand-logo" src={sitePath('/images/brand/oicl-fiber-wordmark.svg')} alt="" width="405" height="122" />
              <span class="brand-title"><span class="brand-title-text"><strong>{settings.officialName || settings.labName}</strong>{settings.chineseName && <span lang="zh-CN">{settings.chineseName}</span>}</span></span>
            </span>
          </a>
          <p>{settings.affiliation}</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          {nav.slice(1).map((item) => <a href={sitePath(item.href)}>{item.label}</a>)}
        </nav>
        <div class="footer-end">
          {settings.contactEmail && <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>}
          <small>© {new Date().getFullYear()} OICL</small>
        </div>
      </div>
    </footer>
  </body>
</html>
