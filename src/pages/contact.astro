---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';
const content = await getSiteContent();
const { settings } = content;
---
<BaseLayout title="Contact" description="Contact OICL for research exchange and potential collaboration." active="contact" content={content}>
  <section class="page-hero shell"><div class="hero-index"><span class="index-line"></span><span>CONTACT / OICL</span></div><h1>Let's connect<br />through <em>research.</em></h1><p>We welcome thoughtful conversations about optical communications and research collaboration.</p></section>
  <section class="section shell contact-layout"><div class="contact-main"><span class="eyebrow">REACH THE LAB</span><h2>Start a conversation.</h2>{settings.contactEmail ? <a class="contact-email" href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}<span aria-hidden="true">↗</span></a> : <p class="contact-unavailable">The official collaboration email will be published after verification.</p>}<p>For research exchange, please include a short introduction and the topic you would like to discuss.</p></div><div class="contact-details"><div><span class="eyebrow">LABORATORY</span><p>{settings.officialName || settings.labName}</p>{settings.chineseName && <p lang="zh-CN">{settings.chineseName}</p>}</div><div><span class="eyebrow">AFFILIATION</span><p>{settings.affiliation || 'Pending confirmation'}</p></div>{settings.location && <div><span class="eyebrow">LOCATION</span><p>{settings.location}</p></div>}</div></section>
</BaseLayout>
