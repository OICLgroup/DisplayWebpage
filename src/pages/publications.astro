---
import { sitePath } from '../lib/paths';
const destination = sitePath('/outcomes/#publications');
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta http-equiv="refresh" content={`0; url=${destination}`} /><link rel="canonical" href={new URL(destination, Astro.site || Astro.url).href} /><title>Publications moved | OICL</title></head>
  <body><p>Publications are now under <a href={destination}>OICL Outcomes</a>.</p></body>
</html>
