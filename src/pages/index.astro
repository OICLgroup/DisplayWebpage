---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import HeroVisual from '../components/HeroVisual.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getSiteContent } from '../lib/content';
import { sitePath } from '../lib/paths';

const content = await getSiteContent();
const { settings, themes, publications, people, news } = content;
const featured = publications.filter((item) => item.featured).slice(0, 3);
const selected = featured.length ? featured : publications.slice(0, 3);
---
<BaseLayout title="Home" description="OICL research in optical communications, publications, people and collaboration." active="home" content={content}>
  <section class="hero shell">
    <div class="hero-copy">
      <div class="hero-index"><span class="index-line"></span><span>OICL / OPTICAL COMMUNICATIONS</span></div>
      <h1>Exploring<br /><em>optical</em><br />communications<span class="accent-period">.</span></h1>
      <p class="hero-lead">{settings.heroStatement && settings.heroStatement !== 'Exploring optical communications.' ? settings.heroStatement : settings.intro}</p>
      {settings.heroStatement && settings.heroStatement !== 'Exploring optical communications.' && settings.intro && <p class="hero-support">{settings.intro}</p>}
      <div class="hero-actions"><a class="button button-primary" href={sitePath('/research/')}>Explore our research <span aria-hidden="true">↗</span></a><a class="button button-quiet" href={sitePath('/contact/')}>Get in touch <span aria-hidden="true">→</span></a></div>
      <div class="hero-footnote"><span class="footnote-mark">✳</span><span>{settings.affiliation || 'Independent website preview · affiliation pending confirmation'}</span></div>
    </div>
    <HeroVisual />
  </section>

  <section class="intro-band">
    <div class="shell intro-band-inner"><span class="eyebrow">THE FIELD</span><p>Light is a medium for connection. <span>We study optical communications and the systems that make information move.</span></p><span class="band-arrow" aria-hidden="true">↘</span></div>
  </section>

  <section class="section shell focus-section">
    <SectionHeading eyebrow="01 / RESEARCH" title="What we explore" intro="A clear view of the questions and methods behind the work." href="/research/" linkText="All research" />
    {themes.length > 0 ? <div class="theme-grid">
      {themes.slice(0, 4).map((theme, index) => <a class="theme-card" href={sitePath(`/research/#${theme.slug || theme.id}`)}>
        {theme.imageUrl && <img src={theme.imageUrl} alt={theme.imageAlt || ''} loading="lazy" />}
        <div class="theme-card-top"><span>{String(index + 1).padStart(2, '0')}</span><span aria-hidden="true">↗</span></div>
        <div><h3>{theme.title}</h3>{theme.chineseTitle && <span class="chinese-label" lang="zh-CN">{theme.chineseTitle}</span>}<p>{theme.summary}</p></div>
      </a>)}
    </div> : <div class="focus-preview"><div class="focus-graphic"><span class="focus-orbit orbit-one"></span><span class="focus-orbit orbit-two"></span><span class="focus-core"></span></div><div><span class="eyebrow">CORE FIELD</span><h3>Optical communications</h3><p>Specific research themes will be added here after the laboratory confirms its current areas of work.</p><a class="text-link" href={sitePath('/research/')}>Explore the research page <span aria-hidden="true">↗</span></a></div></div>}
  </section>

  {selected.length > 0 && <section class="section section-tinted">
    <div class="shell"><SectionHeading eyebrow="02 / SELECTED OUTPUTS" title="Recent work" intro="Selected publications from the laboratory." href="/publications/" linkText="View all publications" /><div class="publication-list">{selected.map((item) => <PublicationItem publication={item} compact />)}</div></div>
  </section>}

  {people.length > 0 && <section class="section shell people-teaser"><div><span class="eyebrow">03 / PEOPLE</span><h2>Research is a<br /><em>collective effort.</em></h2></div><div><p>Meet the people behind OICL and the questions they work on together.</p><a class="button button-outline" href={sitePath('/people/')}>Meet the team <span aria-hidden="true">↗</span></a></div></section>}

  {news.length > 0 && <section class="section shell news-section"><SectionHeading eyebrow="LATEST" title="From the lab" /><div class="news-grid">{news.slice(0, 3).map((item) => <article class="news-card"><time datetime={item.date}>{item.date}</time><h3 lang={item.language === 'zh' ? 'zh-CN' : undefined}>{item.title}</h3>{item.language === 'zh' && <span class="language-tag">Chinese only</span>}{item.summary && <p>{item.summary}</p>}{item.url && <a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">Read more <span aria-hidden="true">↗</span></a>}</article>)}</div></section>}

  <section class="contact-strip"><div class="shell contact-strip-inner"><div><span class="eyebrow">CONNECT WITH OICL</span><h2>Let’s start a conversation<span class="accent-period">.</span></h2><p>For research exchange and potential collaboration.</p></div><a class="button button-light" href={sitePath('/contact/')}>Contact the lab <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
