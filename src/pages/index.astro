---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import HeroVisual from '../components/HeroVisual.astro';
import ResearchVisual from '../components/ResearchVisual.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { activityDateLabel, getSiteContent, personSlug } from '../lib/content';
import { sitePath } from '../lib/paths';

const content = await getSiteContent();
const { settings, themes, publications, people, activities } = content;
const selected = publications.filter((item) => item.featured).slice(0, 3);
const featuredPublications = selected.length ? selected : publications.slice(0, 3);
const pi = people.find((person) => person.group === 'Professors' || /professor/i.test(person.role));
const portrait = pi?.portraitUrl?.startsWith('/') ? sitePath(pi.portraitUrl) : pi?.portraitUrl;
---
<BaseLayout title="Home" description="OICL studies optical interconnects, switching and resilient networks for AI computing." active="home" content={content}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="hero-kicker"><span class="kicker-line"></span> GREAT BAY UNIVERSITY / OICL</div>
        <p class="hero-lab-name">{settings.officialName || settings.labName}</p>
        <h1>Light moves<br /><em>intelligence</em><br />forward<span>.</span></h1>
        <p class="hero-lead">{settings.heroStatement || settings.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={sitePath('/research/')}>Explore our research <span aria-hidden="true">↗</span></a>
          <a class="button button-plain" href={sitePath('/contact/')}>Contact OICL <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-chinese" lang="zh-CN">{settings.chineseName || '光信息通信实验室'}</p>
      </div>
      <HeroVisual />
    </div>
  </section>

  <section class="mission-band">
    <div class="shell mission-grid">
      <span class="eyebrow">OUR FOCUS / 研究定位</span>
      <p>{settings.intro}</p>
      {settings.chineseIntro && <p class="mission-chinese" lang="zh-CN">{settings.chineseIntro}</p>}
    </div>
  </section>

  <section class="section shell" id="research">
    <SectionHeading eyebrow="01 / RESEARCH" title="Three paths. One connected future." intro="Optical systems and networks built for the demands of AI computing." href="/research/" linkText="View research" />
    <div class="research-card-grid">
      {themes.slice(0, 3).map((theme, index) => <a class="research-card" href={sitePath(`/research/#${theme.slug || theme.id}`)}>
        <div class="research-card-art"><ResearchVisual variant={index} /></div>
        <div class="research-card-body"><span class="card-index">0{index + 1} / 03</span><h3>{theme.title}</h3>{theme.chineseTitle && <p class="chinese-label" lang="zh-CN">{theme.chineseTitle}</p>}<p>{theme.summary}</p><span class="card-arrow" aria-hidden="true">↗</span></div>
      </a>)}
    </div>
  </section>

  <section class="application-band">
    <div class="shell application-inner"><span class="eyebrow">APPLICATION SCENARIOS</span><p>{settings.applicationStatement || 'Optical systems and networks for AI and 6G.'}</p><a href={sitePath('/research/')}>Explore the research <span aria-hidden="true">↗</span></a></div>
  </section>

  {featuredPublications.length > 0 && <section class="section shell">
    <SectionHeading eyebrow="02 / OUTCOMES" title="Selected work" intro="Research results and publications from OICL." href="/outcomes/" linkText="All outcomes" />
    <div class="publication-list">{featuredPublications.map((item) => <PublicationItem publication={item} compact />)}</div>
  </section>}

  {pi && <section class="section team-band">
    <div class="shell team-inner">
      <div class="team-copy"><span class="eyebrow">03 / PEOPLE</span><h2>Meet the mind<br />behind the lab<span>.</span></h2><p>Research is driven by people who connect fundamental ideas with practical systems.</p><a class="button button-outline" href={sitePath(`/people/${personSlug(pi)}/`)}>Meet Prof. {pi.name} <span aria-hidden="true">↗</span></a></div>
      <div class="team-portrait">{portrait ? <img src={portrait} alt={pi.portraitAlt || `Portrait of ${pi.name}`} loading="lazy" /> : <span aria-hidden="true">{pi.name.split(' ').map((part) => part[0]).join('')}</span>}<div><strong>Prof. {pi.name}</strong>{pi.chineseName && <span lang="zh-CN">{pi.chineseName}</span>}<small>Principal Investigator</small></div></div>
    </div>
  </section>}

  {activities.length > 0 && <section class="section shell"><SectionHeading eyebrow="04 / ACTIVITIES" title="From the lab" href="/activities/" linkText="View activities" /><div class="activity-teasers">{activities.slice(0, 2).map((item) => <a href={sitePath('/activities/')}><time datetime={item.date || item.month}>{activityDateLabel(item)}</time><h3 lang={item.language === 'zh' ? 'zh-CN' : undefined}>{item.title}</h3><span aria-hidden="true">↗</span></a>)}</div></section>}

  <section class="contact-callout"><div class="shell contact-callout-inner"><div><span class="eyebrow">CONNECT / 交流与招聘</span><h2>Let's build what comes next<span>.</span></h2><p>For research exchange and collaboration with OICL.</p></div><a class="button button-light" href={sitePath('/contact/')}>Get in touch <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
