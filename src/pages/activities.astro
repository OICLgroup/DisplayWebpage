---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';
const content = await getSiteContent();
const { activities } = content;
---
<BaseLayout title="Activities" description="Research and life at OICL." active="activities" content={content}>
  <section class="page-hero shell"><span class="eyebrow">OICL / 研究与生活</span><h1>Activities<span>.</span></h1><p>Updates from our research community, shared as they happen.</p></section>
  <section class="section shell">{activities.length ? <div class="activity-list">{activities.map((item) => <article class="activity-item"><time datetime={item.date}>{new Date(`${item.date}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time><div><h2 lang={item.language === 'zh' ? 'zh-CN' : undefined}>{item.title}</h2>{item.language === 'zh' && <span class="language-tag">Chinese only</span>}{item.summary && <p>{item.summary}</p>}{item.images && item.images.length > 0 && <div class="activity-images">{item.images.map((image) => <img src={image.url} alt={image.alt} loading="lazy" />)}</div>}{item.url && <a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">More information <span aria-hidden="true">↗</span></a>}</div></article>)}</div> : <div class="empty-state empty-state-large"><span class="empty-icon" aria-hidden="true">✳</span><h2>Activities are being collected</h2><p>Updates and photographs will appear here after they are prepared for publication.</p></div>}</section>
</BaseLayout>
