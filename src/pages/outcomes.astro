---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getSiteContent, type Outcome } from '../lib/content';
const content = await getSiteContent();
const { outcomes } = content;
const isNingDengPaper = (item: (typeof content.publications)[number]) =>
  (item.type === 'Journal' || item.type === 'Conference') && /\bN\.?\s+Deng\b/i.test(item.authors);
const publications = content.publications.filter((item) =>
  !item.hideFromOutcomes && (item.year > 2023 || isNingDengPaper(item))
);
const recentYears = [...new Set(publications.filter((item) => item.year > 2023).map((item) => item.year))].sort((a, b) => b - a);
const earlierItems = publications.filter((item) => item.year <= 2023);
const publicationGroups = [
  ...recentYears.map((year) => ({ id: `year-${year}`, title: String(year), items: publications.filter((item) => item.year === year), earlier: false })),
  ...(earlierItems.length ? [{ id: 'year-2023-and-earlier', title: '2023 and Earlier', items: earlierItems, earlier: true }] : [])
];
const categories = [
  { id: 'prototypes', title: 'Prototypes', kind: 'Prototype' },
  { id: 'applications', title: 'Applications', kind: 'Application' }
] as const;
---
<BaseLayout title="Outcomes" description="OICL publications, prototypes and applications." active="outcomes" content={content}>
  <section class="page-hero shell"><span class="eyebrow">OICL / 研究成果</span><h1>Outcomes<span>.</span></h1><p>Publications, prototypes and applications emerging from our research.</p></section>
  <nav class="section-nav shell" aria-label="Outcome categories"><a href="#publications">Publications</a><a href="#prototypes">Prototypes</a><a href="#applications">Applications</a></nav>
  <section class="section shell" id="publications"><div class="section-heading"><div><span class="eyebrow">01 / OUTCOMES</span><h2>Publications</h2><p>Recent records by year; earlier papers are grouped together. Source links appear where confirmed.</p></div></div>
    {publicationGroups.length ? <div class="year-groups">{publicationGroups.map((group) => <section class="year-group" aria-labelledby={group.id}><h3 id={group.id}>{group.title}</h3><div class="publication-list">{group.items.map((item) => <PublicationItem publication={item} showYearInMeta={group.earlier} />)}</div></section>)}</div> : <div class="empty-state"><h3>Publication list in preparation</h3><p>Confirmed citations will be added here.</p></div>}
  </section>
  {categories.map((category, index) => {
    const items = outcomes.filter((item): item is Outcome => item.kind === category.kind);
    return <section class="section section-soft" id={category.id}><div class="shell"><div class="section-heading"><div><span class="eyebrow">0{index + 2} / OUTCOMES</span><h2>{category.title}</h2></div></div>
      {items.length ? <div class="outcome-grid">{items.map((item) => <article class="outcome-card">{item.imageUrl && <img src={item.imageUrl} alt={item.imageAlt || ''} loading="lazy" />}<div class="outcome-copy">{item.year && <span class="card-index">{item.year}</span>}<h3 lang={item.language === 'zh' ? 'zh-CN' : undefined}>{item.title}</h3>{item.language === 'zh' && <span class="language-tag">Chinese only</span>}<p>{item.summary}</p>{item.url && <a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">View source <span aria-hidden="true">↗</span></a>}</div></article>)}</div> : <div class="empty-state"><span class="empty-icon" aria-hidden="true">✳</span><h3>Details in preparation</h3><p>Verified {category.title.toLowerCase()} will appear here when available.</p></div>}
    </div></section>;
  })}
</BaseLayout>
