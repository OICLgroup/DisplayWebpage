---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';
const content = await getSiteContent();
const { people } = content;
---
<BaseLayout title="People" description="Meet the researchers and students of OICL." active="people" content={content}>
  <section class="page-hero shell"><div class="hero-index"><span class="index-line"></span><span>PEOPLE / OICL</span></div><h1>The people<br />behind <em>OICL.</em></h1><p>Researchers, students and collaborators who make the work possible.</p></section>
  <section class="section shell page-content">
    {people.length > 0 ? <div class:list={['people-grid', { 'people-grid-single': people.length === 1 }]}>{people.map((person) => <article class="person-card"><div class="person-photo">{person.portraitUrl ? <img src={person.portraitUrl} alt={person.portraitAlt || `Portrait of ${person.name}`} loading="lazy" /> : <span aria-hidden="true">{person.name.split(/\s+/).map((part) => part[0]).slice(0, 2).join('')}</span>}</div><div class="person-info"><span class="eyebrow">{person.role}</span><h2>{person.name}</h2>{person.chineseName && <span class="chinese-label" lang="zh-CN">{person.chineseName}</span>}{person.focus && <p>{person.focus}</p>}{person.biography && <p>{person.biography}</p>}<div class="person-links">{person.profileUrl && <a href={person.profileUrl} target="_blank" rel="noopener noreferrer">Profile ↗</a>}{person.email && <a href={`mailto:${person.email}`}>Email ↗</a>}</div></div></article>)}</div>
    : <div class="content-pending"><span class="eyebrow">TEAM PROFILE IN PREPARATION</span><h2>Meet the team, soon.</h2><p>Names, roles and portraits will be published only after the laboratory confirms them.</p><div class="pending-line" aria-hidden="true"><span></span><span></span><span></span></div></div>}
  </section>
</BaseLayout>
