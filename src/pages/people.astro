---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent, personSlug, type Person } from '../lib/content';
import { sitePath } from '../lib/paths';
const content = await getSiteContent();
const groups = ['Professors', 'Researchers', 'Students'] as const;
function inGroup(person: Person, group: typeof groups[number]): boolean {
  if (person.group) return person.group === group;
  if (group === 'Professors') return /professor/i.test(person.role);
  if (group === 'Students') return /student|master|phd/i.test(person.role);
  return !/professor|student|master|phd/i.test(person.role);
}
---
<BaseLayout title="People" description="Meet OICL's professors, researchers and students." active="people" content={content}>
  <section class="page-hero shell"><span class="eyebrow">OICL / 研究人员</span><h1>People<span>.</span></h1><p>Meet the researchers behind the work.</p></section>
  {groups.map((group, groupIndex) => {
    const members = content.people.filter((person) => inGroup(person, group));
    return <section class:list={['section', { 'section-soft': groupIndex % 2 === 1 }]} id={group.toLowerCase()}><div class="shell"><div class="people-group-heading"><span class="eyebrow">0{groupIndex + 1} / PEOPLE</span><h2>{group}</h2></div>
      {members.length ? <div class="people-list">{members.map((person) => {
        const portrait = person.portraitUrl?.startsWith('/') ? sitePath(person.portraitUrl) : person.portraitUrl;
        return <article class="person-feature"><a class="person-image" href={sitePath(`/people/${personSlug(person)}/`)} aria-label={`View ${person.name}'s profile`}>{portrait ? <img src={portrait} alt={person.portraitAlt || `Portrait of ${person.name}`} loading="lazy" /> : <span aria-hidden="true">{person.name.split(/\s+/).map((part) => part[0]).join('')}</span>}</a><div class="person-feature-copy"><span class="card-index">{person.role}</span><h3>{person.name}</h3>{person.chineseName && <span class="chinese-label" lang="zh-CN">{person.chineseName}</span>}{person.focus && <p>{person.focus}</p>}<a class="text-link" href={sitePath(`/people/${personSlug(person)}/`)}>View profile <span aria-hidden="true">↗</span></a></div></article>;
      })}</div> : <div class="empty-state"><span class="empty-icon" aria-hidden="true">✳</span><h3>Profiles in preparation</h3><p>Confirmed names and research details will appear here when available.</p></div>}
    </div></section>;
  })}
</BaseLayout>
