---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent, type ResearchTheme } from '../lib/content';
import { sitePath } from '../lib/paths';
const content = await getSiteContent();
const { settings, themes, people } = content;
const pi = people.find((person) => person.group === 'Professors' || /professor/i.test(person.role));

// PPT order: short-reach (top), resilient networks (bottom-left), flexible switching (bottom-right).
const desiredOrder = ['short-reach-optical-interconnects', 'resilient-optical-networks', 'flexible-optical-switching'];
// Each area shows two stacked figures, matching the laboratory PPT layout.
const figureSets: Record<string, string[]> = {
  'short-reach-optical-interconnects': ['/images/research/short-reach-system.png', '/images/research/short-reach-measurements.png'],
  'resilient-optical-networks': ['/images/research/resilient-ocs-topology.png', '/images/research/resilient-recovery-timeline.png'],
  'flexible-optical-switching': ['/images/research/optical-switching-bench.png', '/images/research/optical-switching-schematic.png']
};
const known = desiredOrder.map((slug) => themes.find((theme) => theme.slug === slug)).filter((theme): theme is ResearchTheme => Boolean(theme));
const ordered = [...known, ...themes.filter((theme) => !desiredOrder.includes(theme.slug))];
const areaNames = ['short', 'resil', 'flex'];
const areaFlags = ['High Capacity', 'High Resilience', 'High Capacity'];
const areas = ordered.slice(0, 3).map((theme, index) => {
  const set = figureSets[theme.slug] || [];
  const sources = ([theme.imageUrl || set[0], set[1]].filter((src, position, list) => Boolean(src) && list.indexOf(src) === position)) as string[];
  const figures = sources.map((src) => (src.startsWith('/') && !src.startsWith(import.meta.env.BASE_URL) ? sitePath(src) : src));
  return { ...theme, area: areaNames[index], flag: areaFlags[index], figures };
});
---
<BaseLayout title="Research" description="OICL research in optical interconnects, flexible switching and resilient optical networks." active="research" content={content}>
  <section class="page-hero shell">
    <div class="research-hero-grid">
      <div>
        <span class="eyebrow">OICL / 研究领域</span>
        <h1>Research<span>.</span></h1>
        <p>Optical systems and networks for AI and 6G.</p>
      </div>
      {pi && <figure class="research-pi-card">
        <img src={sitePath('/images/ning-deng-research.jpeg')} alt={`Portrait of Prof. ${pi.name}`} />
        <figcaption>
          <span class="eyebrow">PRINCIPAL INVESTIGATOR</span>
          <strong>Prof. {pi.name}</strong>
          {pi.chineseName && <span class="chinese-label" lang="zh-CN">{pi.chineseName}教授</span>}
          <a class="text-link" href={sitePath(`/people/${pi.slug || 'ning-deng'}/`)}>View profile <span aria-hidden="true">↗</span></a>
        </figcaption>
      </figure>}
    </div>
  </section>

  <section class="section shell research-flow">
    <div class="research-flow-intro">
      <span class="eyebrow">RESEARCH PROFILE</span>
      <p class="research-flow-lead">{settings.intro}</p>
      {settings.chineseIntro && <p class="research-flow-lead chinese-paragraph" lang="zh-CN">{settings.chineseIntro}</p>}
    </div>

    <p class="research-flow-scenario">
      <span class="eyebrow">APPLICATION SCENARIOS / 应用场景</span>
      <span>{settings.applicationStatement || 'Optical Systems and Networks for AI and 6G'}{settings.applicationChinese && <span lang="zh-CN"> · {settings.applicationChinese}</span>}</span>
      {settings.networkStandards && <span class="research-flow-standards" lang="zh-CN">{settings.networkStandards}</span>}
    </p>

    <figure class="research-scenario-figure">
      <div class="research-scenario-images">
        <a href={sitePath('/images/research/ai-6g-optical-network.png')} target="_blank" rel="noopener noreferrer" aria-label="Open full-size optical network architecture diagram"><img src={sitePath('/images/research/ai-6g-optical-network.png')} alt="Diagram showing AI computing centers, data centers and 5G/6G networks connected through optical networks" loading="lazy" /></a>
        <a href={sitePath('/images/research/ai-data-center.jpeg')} target="_blank" rel="noopener noreferrer" aria-label="Open full-size AI data center illustration"><img src={sitePath('/images/research/ai-data-center.jpeg')} alt="AI data center supporting optical information and communications research" loading="lazy" /></a>
      </div>
    </figure>

    <div class="research-map" aria-label="Key research areas around the AI optical network">
      <div class="research-hub">
        <div class="research-hub-shape"><strong>AI</strong><span>Optical Network</span></div>
      </div>
      {areas.map((theme) => <article class:list={['research-area', `research-area-${theme.area}`]} id={theme.slug}>
        <span class="research-area-flag">{theme.flag}</span>
        <h2>{theme.title}</h2>
        {theme.chineseTitle && <span class="chinese-label" lang="zh-CN">{theme.chineseTitle}</span>}
        {theme.figures.length > 0 && <div class="research-area-figures">
          {theme.figures.map((figure, figureIndex) => <a class="research-area-figure" href={figure} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size figure: ${theme.title}`}><img src={figure} alt={figureIndex === 0 ? (theme.imageAlt || theme.title) : `${theme.title}, additional figure`} loading="lazy" /></a>)}
        </div>}
        <p>{theme.summary}</p>
      </article>)}
    </div>

    <p class="research-flow-end"><a class="text-link" href={sitePath('/contact/')}>Discuss the research <span aria-hidden="true">↗</span></a></p>
  </section>
</BaseLayout>
