---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { getSiteContent, personSlug, type Person, type SiteContent } from '../../lib/content';
import { sitePath } from '../../lib/paths';

export async function getStaticPaths() {
  const content = await getSiteContent();
  return content.people.map((person) => ({ params: { slug: personSlug(person) }, props: { person, content } }));
}
type Props = { person: Person; content: SiteContent };
const { person, content } = Astro.props;
const portrait = person.portraitUrl?.startsWith('/') ? sitePath(person.portraitUrl) : person.portraitUrl;
const related = content.publications.filter((item) => /\bDeng\b/i.test(item.authors));
---
<BaseLayout title={person.name} description={`Profile of ${person.name} at OICL.`} active="people" content={content}>
  <section class="profile-header shell"><a class="back-link" href={sitePath('/people/')}>← All people</a><span class="eyebrow">{person.group || 'PEOPLE'} / OICL</span><h1>{person.name}<span>.</span></h1>{person.chineseName && <p class="profile-chinese" lang="zh-CN">{person.chineseName}</p>}<p class="profile-role">{person.role}</p></section>
  <section class="section shell profile-layout">
    <aside class="profile-aside"><div class="profile-portrait">{portrait ? <img src={portrait} alt={person.portraitAlt || `Portrait of ${person.name}`} /> : <span aria-hidden="true">{person.name.split(/\s+/).map((part) => part[0]).join('')}</span>}</div><div class="profile-contact">{person.email && <a href={`mailto:${person.email}`}>Email <span aria-hidden="true">↗</span></a>}{person.profileUrl && <a href={person.profileUrl} target="_blank" rel="noopener noreferrer">GBU profile <span aria-hidden="true">↗</span></a>}</div></aside>
    <div class="profile-main"><span class="eyebrow">ABOUT</span>{person.biography ? <p class="profile-bio">{person.biography}</p> : <p class="profile-bio">Biography in preparation.</p>}{person.focus && <div class="profile-focus"><span class="eyebrow">RESEARCH FOCUS</span><p>{person.focus}</p></div>}</div>
  </section>
  {related.length > 0 && <section class="section section-soft"><div class="shell"><div class="section-heading"><div><span class="eyebrow">REPRESENTATIVE WORK</span><h2>Publications and patents</h2></div><a class="text-link" href={sitePath('/outcomes/#publications')}>All outcomes <span aria-hidden="true">↗</span></a></div><div class="publication-list">{related.map((item) => <PublicationItem publication={item} compact />)}</div></div></section>}
</BaseLayout>
