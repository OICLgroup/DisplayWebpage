---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteContent, personSlug, publicationUrl, type AcademicRecord, type Person, type Publication, type SiteContent } from '../../lib/content';
import { sitePath } from '../../lib/paths';
import { hyphenateText } from '../../lib/hyphenate';

export async function getStaticPaths() {
  const content = await getSiteContent();
  return content.people.map((person) => ({ params: { slug: personSlug(person) }, props: { person, content } }));
}
type Props = { person: Person; content: SiteContent };
const { person, content } = Astro.props;
const portraitUrl = person.portraitUrl?.startsWith('/') ? sitePath(person.portraitUrl) : person.portraitUrl;
const portrait = portraitUrl?.startsWith('https://cdn.sanity.io/images/') ? `${portraitUrl}?w=1000&auto=format` : portraitUrl;
const relatedPublications = person.featuredPublications?.length
  ? person.featuredPublications
  : personSlug(person) === 'ning-deng'
    ? content.publications.filter((item) => /\bDeng\b/i.test(item.authors))
    : [];
const academicRecords = person.academicRecords || [];
const researchProjects = person.researchProjects || [];
const longBiography = (person.biography?.length || 0) > 500;

type RecordKind = AcademicRecord['kind'] | 'standard' | 'other';
type ProfileEntry = { kind: RecordKind; record?: AcademicRecord; publication?: Publication };

function publicationKind(publication: Publication): RecordKind {
  if (publication.type === 'Journal') return 'journal';
  if (publication.type === 'Conference') return 'conference';
  if (/patent/i.test(publication.venue)) return 'patent';
  if (/recommendation|\bITU-T\b/i.test(publication.venue)) return 'standard';
  if (/book|chapter|elsevier/i.test(publication.venue)) return 'book';
  return 'other';
}

const profileEntries: ProfileEntry[] = academicRecords.length
  ? academicRecords.map((record) => ({ kind: record.kind, record }))
  : relatedPublications.map((publication) => ({ kind: publicationKind(publication), publication }));
const recordHeading = profileEntries.some((entry) => entry.kind === 'patent') ? 'Publications and patents' : 'Publications';
const recordGroups = [
  { kind: 'journal', title: 'Journal articles', id: 'journals' },
  { kind: 'conference', title: 'Conference papers', id: 'conferences' },
  { kind: 'book', title: 'Book chapters', id: 'book-chapters' },
  { kind: 'patent', title: 'Patents', id: 'patents' },
  { kind: 'standard', title: 'Standards', id: 'standards' },
  { kind: 'other', title: 'Other works', id: 'other-works' }
] as const;
const visibleGroups = recordGroups.map((group) => ({
  ...group,
  entries: profileEntries.filter((entry) => entry.kind === group.kind)
})).filter((group) => group.entries.length > 0);

function sourceLabel(url: string, citation?: string): string {
  if (/^https:\/\/(?:www\.)?ecoc2026\.org\//i.test(url)) return 'Conference programme';
  if (citation && /accepted/i.test(citation) && !/doi\.org/i.test(url)) return 'Author record';
  return 'Original source';
}
---
<BaseLayout title={person.name} description={`Profile of ${person.name} at OICL.`} active="people" content={content}>
  <section class="profile-header shell"><a class="back-link" href={sitePath('/people/')}>← All people</a><span class="eyebrow">{person.group || 'PEOPLE'} / OICL</span><h1>{person.name}<span>.</span></h1>{person.chineseName && <p class="profile-chinese" lang="zh-CN">{person.chineseName}</p>}<p class="profile-role">{person.role}</p></section>
  <section class="section shell profile-layout">
    <aside class="profile-aside"><div class="profile-portrait">{portrait ? <img src={portrait} alt={person.portraitAlt || `Portrait of ${person.name}`} /> : <span aria-hidden="true">{person.name.split(/\s+/).map((part) => part[0]).join('')}</span>}</div><div class="profile-contact">{person.email && <a href={`mailto:${person.email}`}>Email <span aria-hidden="true">↗</span></a>}{person.profileUrl && <a href={person.profileUrl} target="_blank" rel="noopener noreferrer">External profile <span aria-hidden="true">↗</span></a>}</div></aside>
    <div class="profile-main">{person.biography && <><span class="eyebrow">ABOUT</span><p class:list={['profile-bio', { 'profile-bio-long': longBiography }]}>{hyphenateText(person.biography)}</p></>}{person.focus && <div class="profile-focus"><span class="eyebrow">RESEARCH FOCUS</span><p>{hyphenateText(person.focus)}</p></div>}</div>
  </section>
  {researchProjects.length > 0 && (
    <section class="section shell profile-projects">
      <span class="eyebrow">RESEARCH PROJECTS</span>
      <h2>Research projects</h2>
      <ul>
        {researchProjects.map((project) => <li>
          {project.year && <span class="profile-project-year">{project.year}</span>}
          <div lang={project.language === 'zh' ? 'zh-CN' : undefined}>
            <h3>{project.title}</h3>
            {project.note && <p>{hyphenateText(project.note)}</p>}
          </div>
        </li>)}
      </ul>
    </section>
  )}
  {profileEntries.length > 0 && (
    <section class="section section-soft profile-record-section">
      <div class="shell">
        <div class="section-heading"><div>
          <span class="eyebrow">ACADEMIC RECORD</span>
          <h2>{recordHeading}</h2>
          <p>Research records currently listed for this profile, grouped by type. Source links appear where verified.</p>
        </div></div>
        <nav class="profile-record-nav" aria-label="Academic record sections">
          {visibleGroups.map((group) => <a href={`#${group.id}`}>{group.title} <span>{group.entries.length}</span></a>)}
        </nav>
        {visibleGroups.map((group) => (
          <section class="profile-record-group" id={group.id}>
            <h3>{group.title} <span>{group.entries.length}</span></h3>
            <ol class="profile-record-list">
              {group.entries.map((entry) => {
                const { record, publication } = entry;
                const url = record?.url || (publication ? publicationUrl(publication) : undefined);
                return <li lang={record?.language === 'zh' || publication?.language === 'zh' ? 'zh-CN' : undefined}>
                  {record && <p>{hyphenateText(record.citation)}</p>}
                  {publication && <><p class="profile-record-title">{hyphenateText(publication.title)}</p><p class="profile-record-meta">{publication.authors} · {publication.venue} · {publication.year}</p></>}
                  {url && <a href={url} target="_blank" rel="noopener noreferrer">{sourceLabel(url, record?.citation || publication?.venue)} <span aria-hidden="true">↗</span></a>}
                </li>;
              })}
            </ol>
          </section>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
