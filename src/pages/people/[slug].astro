---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { getSiteContent, personSlug, type Person, type SiteContent } from '../../lib/content';
import { sitePath } from '../../lib/paths';

export async function getStaticPaths() {
  const content = await getSiteContent();
  return content.people.map((person) => ({ params: { slug: personSlug(person) }, props: { person, content } }));
}
type Props = { person: Person; content: SiteContent };
const { person, content } = Astro.props;
const portraitUrl = person.portraitUrl?.startsWith('/') ? sitePath(person.portraitUrl) : person.portraitUrl;
const portrait = portraitUrl?.startsWith('https://cdn.sanity.io/images/') ? `${portraitUrl}?w=1000&auto=format` : portraitUrl;
const related = person.featuredPublications?.length
  ? person.featuredPublications
  : personSlug(person) === 'ning-deng'
    ? content.publications.filter((item) => /\bDeng\b/i.test(item.authors))
    : [];
const academicRecords = person.academicRecords || [];
const recordGroups = [
  { kind: 'journal', title: 'Journal articles', id: 'journals' },
  { kind: 'conference', title: 'Conference papers', id: 'conferences' },
  { kind: 'patent', title: 'Patents', id: 'patents' }
] as const;
---
<BaseLayout title={person.name} description={`Profile of ${person.name} at OICL.`} active="people" content={content}>
  <section class="profile-header shell"><a class="back-link" href={sitePath('/people/')}>← All people</a><span class="eyebrow">{person.group || 'PEOPLE'} / OICL</span><h1>{person.name}<span>.</span></h1>{person.chineseName && <p class="profile-chinese" lang="zh-CN">{person.chineseName}</p>}<p class="profile-role">{person.role}</p></section>
  <section class="section shell profile-layout">
    <aside class="profile-aside"><div class="profile-portrait">{portrait ? <img src={portrait} alt={person.portraitAlt || `Portrait of ${person.name}`} /> : <span aria-hidden="true">{person.name.split(/\s+/).map((part) => part[0]).join('')}</span>}</div><div class="profile-contact">{person.email && <a href={`mailto:${person.email}`}>Email <span aria-hidden="true">↗</span></a>}{person.profileUrl && <a href={person.profileUrl} target="_blank" rel="noopener noreferrer">External profile <span aria-hidden="true">↗</span></a>}</div></aside>
    <div class="profile-main">{person.biography && <><span class="eyebrow">ABOUT</span><p class="profile-bio">{person.biography}</p></>}{person.focus && <div class="profile-focus"><span class="eyebrow">RESEARCH FOCUS</span><p>{person.focus}</p></div>}</div>
  </section>
  {academicRecords.length > 0 && <section class="section section-soft profile-record-section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">ACADEMIC RECORD</span><h2>Publications and patents</h2><p>Full citation list supplied for this profile. Source links appear where verified.</p></div></div><nav class="profile-record-nav" aria-label="Academic record sections">{recordGroups.map((group) => { const count = academicRecords.filter((item) => item.kind === group.kind).length; return count > 0 && <a href={`#${group.id}`}>{group.title} <span>{count}</span></a>; })}</nav>{recordGroups.map((group) => { const records = academicRecords.filter((item) => item.kind === group.kind); return records.length > 0 && <section class="profile-record-group" id={group.id}><h3>{group.title} <span>{records.length}</span></h3><ol class="profile-record-list">{records.map((record) => <li lang={record.language === 'zh' ? 'zh-CN' : undefined}><p>{record.citation}</p>{record.url && <a href={record.url} target="_blank" rel="noopener noreferrer">Original source <span aria-hidden="true">↗</span></a>}</li>)}</ol></section>; })}</div></section>}
  {related.length > 0 && academicRecords.length === 0 && <section class="section section-soft"><div class="shell"><div class="section-heading"><div><span class="eyebrow">REPRESENTATIVE WORK</span><h2>{personSlug(person) === 'ning-deng' ? 'Publications and patents' : 'Selected publications'}</h2></div><a class="text-link" href={sitePath('/outcomes/#publications')}>All outcomes <span aria-hidden="true">↗</span></a></div><div class="publication-list">{related.map((item) => <PublicationItem publication={item} compact />)}</div></div></section>}
</BaseLayout>
