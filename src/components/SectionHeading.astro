---
type Props = { eyebrow: string; title: string; intro?: string; href?: string; linkText?: string };
import { sitePath } from '../lib/paths';
const { eyebrow, title, intro, href, linkText } = Astro.props;
---
<div class="section-heading">
  <div>
    <span class="eyebrow">{eyebrow}</span>
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
  {href && <a class="text-link" href={sitePath(href)}>{linkText || 'Explore'} <span aria-hidden="true">↗</span></a>}
</div>
