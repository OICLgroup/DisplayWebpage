---
import { publicationUrl, type Publication } from '../lib/content';
type Props = { publication: Publication; compact?: boolean };
const { publication, compact = false } = Astro.props;
const href = publicationUrl(publication);
---
<article class:list={['publication-item', { compact }]}>
  <div class="publication-year">{publication.year}</div>
  <div class="publication-main">
    <div class="publication-meta"><span>{publication.type || 'Publication'}</span><span class="meta-separator"></span><span>{publication.venue}</span>{publication.language === 'zh' && <span class="language-tag">Chinese only</span>}</div>
    <h3 lang={publication.language === 'zh' ? 'zh-CN' : undefined}>{publication.title}</h3>
    <p>{publication.authors}</p>
  </div>
  {href && <a class="publication-link" href={href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${publication.title}`}><span aria-hidden="true">↗</span></a>}
</article>
